{
  "version": 2,
  "server": {"port": 8811, "path": "/mcp", "service": "mcp-demo", "scheme": "https"},
  "tools": [
    {
      "name": "get_status",
      "description": "The demo app's current mode, uptime and number of tool calls served.",
      "input_schema": {"type": "object", "properties": {}, "additionalProperties": false},
      "read_only": true
    },
    {
      "name": "list_subscribers",
      "description": "The demo app's subscribers (id, name, plan, note).",
      "input_schema": {
        "type": "object",
        "properties": {"limit": {"type": "integer", "minimum": 1, "maximum": 50}},
        "additionalProperties": false
      },
      "read_only": true
    },
    {
      "name": "set_mode",
      "description": "Switch the demo app between normal and maintenance mode.",
      "input_schema": {
        "type": "object",
        "properties": {"mode": {"type": "string", "enum": ["normal", "maintenance"]}},
        "required": ["mode"],
        "additionalProperties": false
      },
      "read_only": false
    }
  ]
}
